{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://accounts.tangledwires.co.uk/*",
          "app": "inAppBrowser"
        }
      ]
    },
    "store:default",
    "safe-area-insets-css:default",
    "deep-link:default",
    "safe-area-insets-css:default",
    "dialog:default",
    "fs:default",
    "fs:allow-create",
    "fs:allow-write",
    "android-fs:default",
    "android-fs:allow-write-text-file"
  ]
}